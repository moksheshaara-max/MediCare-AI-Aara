# =========================================================
# MediCare AI - .gitignore
# =========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/
ENV/

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example

# Credentials / Private Keys
credentials.json
service-account*.json
*.pem
*.key

# -------------------------
# Python Tools / Testing
# -------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Node.js / React
# -------------------------
node_modules/
frontend/node_modules/

# Vite
frontend/.vite/
frontend/dist/
frontend/build/

# Other frontend caches
.cache/
.parcel-cache/
.turbo/

# -------------------------
# Build / Temporary Files
# -------------------------
*.tmp
*.temp
*.bak
*.swp

# -------------------------
# Medical Knowledge Base
# -------------------------
# Do NOT upload medical reference PDFs to GitHub
data/documents/*.pdf

# -------------------------
# Generated Reports
# -------------------------
generated_reports/
reports/
*.pdf

# -------------------------
# Local AI / ML Models
# -------------------------
models/
model_cache/
.cache/
.huggingface/

# -------------------------
# Local Databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# OS / Python Misc
# -------------------------
*.egg-info/
dist/
build/
.eggs/

# -------------------------
# Environment-specific files
# -------------------------
*.local
# -------------------------
# MediCare AI local KB / rebuild artifacts
# -------------------------

# Entire local medical document corpus
data/

# KB audit / benchmark / temporary scripts
audit_*.py
benchmark_*.py
compare_*.py
dry_run_*.py
estimate_*.py

# Local rebuild backups
*_before_kb_rebuild.py
database/*_before_kb_rebuild.py
retrieval/*_before_kb_rebuild.py

# Generated KB audit outputs
current_kb_inventory.txt
kb_source_audit.csv
kb_source_audit.txt
pdf_text_audit.csv
textbook_metadata_output.txt

# One-off KB utility scripts
build_clean_icmr_amr_2022_archive.py
build_icmr_amr_2022_pdf.py
inspect_sources.py
inspect_textbook_metadata.py
mark_ocr_status.py
reset_knowledge_base.py
test_bindata_vector.py
validate_icmr_amr_pdf.py

# Registry backups
source_registry_before_ocr_status.csv